# SabPaisa PG 3.0 Payment Gateway Configuration Template
# Copy this file to .env and fill in your actual credentials.
# Run app with: flutter run --dart-define-from-file=.env
# Build APK with: flutter build apk --dart-define-from-file=.env

SABPAISA_API_KEY=your_sabpaisa_api_key_here
SABPAISA_MERCHANT_ID=your_merchant_id_here
SABPAISA_SECRET_KEY=your_secret_key_here
SABPAISA_CLIENT_CODE=your_client_code_here
SABPAISA_PRODUCTION=true

