rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. User Profiles: Only owner can read and update their personal profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 2. Public Catalog (Items & Products): Public read access for browsing, no client write access
    match /items/{itemId} {
      allow read: if true;
      allow write: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    // 3. Categories: Public read access
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    // 4. Banners & Promotional content
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /app_banners/{bannerId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /app_category_covers/{coverId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /app_home_sections/{sectionId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Settings (global store & app status, pause status, banners)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // FCM Device Tokens (Allows app devices to register for push notifications)
    match /fcm_tokens/{tokenId} {
      allow create, update: if true;
      allow read, delete: if isAuthenticated();
    }

    // Broadcast Push Notifications (Campaigns created by admin)
    match /broadcast_notifications/{notificationId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 5. Orders: User can only read and create their own orders.
    // They may only update to cancel their own existing pending order.
    match /orders/{orderId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() 
        && resource.data.userId == request.auth.uid 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'isCurrent', 'updatedAt'])
        && request.resource.data.status == 'Cancelled';
      allow delete: if false;
    }

    // 6. Complaints & Support Tickets: User can submit tickets and view only their own
    match /complaints/{complaintId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // 7. Email Trigger Extension Queue: Authenticated order completion triggers email dispatch
    match /mail/{mailId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if false;
    }

    // Default deny-all for any undefined collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

